datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  name               String
  password_hash      String
  role               String                    @default("USER") // "USER" | "ADMIN"
  status             String                    @default("ACTIVE") // "ACTIVE" | "BANNED"
  two_factor_enabled Boolean                   @default(false)
  two_factor_secret  String?
  created_at         DateTime                  @default(now())

  subscription       SubscriptionAndWallet?
  clusters           ClusterAndWorkspace[]
  transactions       TransactionApprovalQueue[]
  api_keys           ApiKey[]
  sessions           Session[]
  cli_devices        CliDevice[]
  usage_events       UsageEvent[]
  incidents          Incident[]
  policy             Policy?
  notifications      Notification[]
  notification_channels NotificationChannel[]
  prompt_rewrites    PromptRewrite[]
  oauth_accounts     OAuthAccount[]

  @@map("Users")
}

model SubscriptionAndWallet {
  id              String      @id @default(cuid())
  user_id         String      @unique
  plan_id         String
  free_tokens     Int         @default(50000)
  paid_tokens     Int         @default(0)
  max_agents      Int         @default(2)
  purchase_status String      @default("NONE") // "NONE" | "PENDING" | "APPROVED" | "REJECTED"
  updated_at      DateTime    @updatedAt

  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan            PricingPlan @relation(fields: [plan_id], references: [plan_id])

  @@map("Subscriptions_And_Wallets")
}

model PricingPlan {
  plan_id                 String                  @id @default(cuid())
  name                    String                  @unique
  price                   Float
  agent_limit             Int
  included_tokens         Int
  is_public               Boolean                 @default(true)
  requires_admin_approval Boolean                 @default(false)
  description             String                  @db.Text

  subscriptions           SubscriptionAndWallet[]

  @@map("Pricing_Plans")
}

model ClusterAndWorkspace {
  cluster_id          String       @id @default(cuid())
  user_id             String
  name                String
  environment         String       // "CLOUD" | "LOCAL_PC"
  active_agents       Int          @default(0)
  hibernated_agents   Int          @default(0)
  cached_context_hash String?
  cache_tokens_saved  Int          @default(0)
  zero_trust_local    Boolean      @default(true)
  created_at          DateTime     @default(now())

  user                User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  agents              Agent[]
  tasks               TaskAndLog[]

  @@map("Clusters_And_Workspaces")
}

model Agent {
  agent_id           String              @id @default(cuid())
  cluster_id         String
  name               String
  agent_type         String              // "ANTIGRAVITY" | "CLAUDE" | "HERMES" | "CLOUD_WORKER"
  status             String              @default("ACTIVE") // "ACTIVE" | "HIBERNATED" | "PAUSED_NUDGE" | "KILLED_LOOP"
  model_tier         String              @default("FRONTIER") // "FRONTIER" | "DOWNGRADED_FAST"
  ram_usage          Float               @default(0)
  cpu_usage          Float               @default(0)
  tokens_used        Int                 @default(0)
  current_task       String?             @db.Text
  locked_file_path   String?             @db.VarChar(512)
  loop_score         Float               @default(0)
  pending_hint       String?             @db.Text
  last_heartbeat_at  DateTime            @default(now())

  cluster            ClusterAndWorkspace @relation(fields: [cluster_id], references: [cluster_id], onDelete: Cascade)

  @@map("Agents")
}

model TaskAndLog {
  task_id          String              @id @default(cuid())
  cluster_id       String
  prompt_summary   String              @db.Text
  complexity_score Int
  assigned_agents  Int
  hibernated_count Int
  tokens_saved     Int
  loop_incidents   Int                 @default(0)
  interception_ms  Int
  status           String              // "RUNNING" | "PAUSED_NUDGE" | "KILLED_LOOP" | "COMPLETED"
  created_at       DateTime            @default(now())

  cluster          ClusterAndWorkspace @relation(fields: [cluster_id], references: [cluster_id], onDelete: Cascade)

  @@map("Tasks_And_Logs")
}

model TransactionApprovalQueue {
  tx_id          String    @id @default(cuid())
  user_id        String
  requested_plan String
  amount         Float
  admin_status   String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  created_at     DateTime  @default(now())
  reviewed_at    DateTime?

  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Transactions_Approval_Queue")
}

model ApiKey {
  id           String    @id @default(cuid())
  user_id      String
  label        String
  key_prefix   String
  key_hash     String    @unique
  last_used_at DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Api_Keys")
}

// ───────────────────────── Phase 0 additions ─────────────────────────

/// Browser/CLI login session. Only a SHA-256 hash of the token is stored.
model Session {
  id          String   @id @default(cuid())
  user_id     String
  token_hash  String   @unique
  user_agent  String?  @db.VarChar(255)
  expires_at  DateTime
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("Sessions")
}

/// A machine paired with the account through `argus login` (device flow).
model CliDevice {
  id           String    @id @default(cuid())
  user_id      String?
  device_code  String    @unique // secret polled by the CLI
  user_code    String    @unique // short code the user types on the website
  name         String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "DENIED" | "EXPIRED"
  api_key_id   String?
  expires_at   DateTime
  last_seen_at DateTime?
  last_polled_at DateTime?
  created_at   DateTime  @default(now())

  user         User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Cli_Devices")
}

/// One row per upstream model request, with provider-reported usage.
model UsageEvent {
  id             String   @id @default(cuid())
  user_id        String
  agent_id       String?
  run_id         String?  // CLI run id
  provider       String   // "anthropic" | "openai" | "google"
  model          String
  input_tokens   Int      @default(0)
  output_tokens  Int      @default(0)
  cost_usd       Float    @default(0)
  latency_ms     Int      @default(0)
  cache_hit      Boolean  @default(false)
  tokens_saved   Int      @default(0)
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([agent_id])
  @@map("Usage_Events")
}

/// A detected problem: loop, waste, bad prompt, budget, RAM.
model Incident {
  id              String          @id @default(cuid())
  user_id         String
  agent_id        String?
  agent_name      String?         @db.VarChar(120)
  loop_type       String?         @db.VarChar(40) // "EXACT_TOOL_LOOP" | "SEMANTIC_REASONING_LOOP"
  kind            String          // "LOOP" | "WASTE" | "BAD_PROMPT" | "BUDGET" | "RAM" | "MUTEX"
  severity        String          @default("WARN") // "INFO" | "WARN" | "CRITICAL"
  action          String          @default("NONE") // "NONE" | "PAUSED" | "KILLED" | "THROTTLED" | "REWRITE_PROPOSED"
  status          String          @default("OPEN") // "OPEN" | "RESOLVED" | "DISMISSED"
  score           Float           @default(0)
  detail          String          @db.Text
  interception_ms Int             @default(0)
  created_at      DateTime        @default(now())
  resolved_at     DateTime?

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rewrites        PromptRewrite[]

  @@index([user_id, created_at])
  @@map("Incidents")
}

/// Per-user guardrail policy (replaces the in-memory policy store).
model Policy {
  id                       String   @id @default(cuid())
  user_id                  String   @unique
  loop_score_threshold     Float    @default(0.85)
  exact_repeat_limit       Int      @default(2)
  nudge_progress_pct       Int      @default(80)
  max_consecutive_retries  Int      @default(3)
  ram_soft_limit_mb        Int      @default(250)
  ram_hard_limit_mb        Int      @default(512)
  token_burn_per_min_limit Int      @default(40000)
  auto_apply_rewrites      Boolean  @default(false)
  auto_downgrade_models    Boolean  @default(true)
  monitor_processes        Boolean  @default(true)
  enforce_mutex            Boolean  @default(true)
  intercept_redundant_api  Boolean  @default(true)
  updated_at               DateTime @updatedAt

  user                     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Policies")
}

model NotificationChannel {
  id         String   @id @default(cuid())
  user_id    String
  kind       String   // "EMAIL" | "WEBHOOK"
  target     String   // address or URL
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Notification_Channels")
}

model Notification {
  id          String    @id @default(cuid())
  user_id     String
  incident_id String?
  title       String
  body        String    @db.Text
  level       String    @default("INFO") // "INFO" | "WARN" | "CRITICAL"
  read_at     DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("Notifications")
}

/// A proposed (or applied) prompt rewrite with a stored diff.
model PromptRewrite {
  id               String    @id @default(cuid())
  user_id          String
  incident_id      String?
  agent_id         String?
  original_prompt  String    @db.LongText
  rewritten_prompt String    @db.LongText
  rationale        String    @db.Text
  tokens_before    Int       @default(0)
  tokens_after     Int       @default(0)
  status           String    @default("PROPOSED") // "PROPOSED" | "APPROVED" | "APPLIED" | "REJECTED"
  created_at       DateTime  @default(now())
  decided_at       DateTime?

  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  incident         Incident? @relation(fields: [incident_id], references: [id], onDelete: SetNull)

  @@map("Prompt_Rewrites")
}

/// Advisory file lock shared by agents (replaces in-memory local-bridge locks).
model FileLock {
  id          String   @id @default(cuid())
  user_id     String
  file_path   String   @db.VarChar(512)
  holder      String   @db.VarChar(120)
  queued_agent String? @db.VarChar(255)
  holder_pid  Int?
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@unique([user_id, file_path])
  @@map("File_Locks")
}

/// USD price per million tokens, used for real cost accounting.
model ModelPrice {
  model           String @id
  provider        String
  input_per_mtok  Float
  output_per_mtok Float

  @@map("Model_Prices")
}


/// A Google/GitHub identity linked to a user. Sign-in resolves (provider, provider_account_id) first.
model OAuthAccount {
  id                  String   @id @default(cuid())
  user_id             String
  provider            String   @db.VarChar(20)  // "google" | "github"
  provider_account_id String   @db.VarChar(191)
  email               String?
  created_at          DateTime @default(now())

  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("OAuth_Accounts")
}
