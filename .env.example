# MySQL connection string (Prisma). Create the database first: CREATE DATABASE argusops CHARACTER SET utf8mb4;
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/argusops"

# Optional seed passwords (random one-time passwords are generated in production if unset)
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# Public origin of this site. Used to build OAuth callback URLs. Required in production.
APP_URL="http://localhost:3000"

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in: https://github.com/settings/developers
# Authorization callback URL: {APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
